<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiApp1.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ユーザー登録">

    <VerticalStackLayout Spacing="15" Padding="30">
        <Label Text="Name" />
        <Entry Placeholder="Type your name." Text="{Binding Name, Mode=TwoWay}" />

        <Label Text="Email" />
        <Entry Placeholder="Type your E-mail." Text="{Binding Email, Mode=TwoWay}" />

        <Button Command="{Binding RegisterCommand}" Text="Submit" />
    </VerticalStackLayout>

</ContentPage>
